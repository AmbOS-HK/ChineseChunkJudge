{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chunkjudge.ambos.cn/schema/contract-chunk.json",
  "title": "ContractChunk",
  "description": "已补齐元信息、字符计数与关系指针的契约切片，是判定的直接对象。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunkId",
    "index",
    "text",
    "startOffset",
    "endOffset",
    "strategy",
    "metadata",
    "charCount",
    "relations"
  ],
  "properties": {
    "chunkId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*@(?:[1-9]|[1-9][0-9]|[1-9][0-9][0-9]|1[0-4][0-9][0-9]|1500)#[0-9]+$",
      "description": "必须等于 {strategy}#{index}，由 CCJ-017 逐字校验；策略名中的 targetSize 限于 1..1500（CCJ-018）。"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "description": "从 0 起连续且不重复；由 CCJ-017 强制。"
    },
    "text": {
      "type": "string"
    },
    "startOffset": {
      "type": "integer",
      "minimum": 0
    },
    "endOffset": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*@(?:[1-9]|[1-9][0-9]|[1-9][0-9][0-9]|1[0-4][0-9][0-9]|1500)$",
      "description": "{type}@{targetSize}，targetSize 限 1..1500。"
    },
    "metadata": {
      "$ref": "./document-feature.json#/$defs/documentMetadata"
    },
    "charCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Unicode 码位数量；必须等于 text 的码位数，由 CCJ-017 强制。"
    },
    "unitKind": {
      "type": "string",
      "enum": ["heading", "article", "paragraph", "sentence", "table", "code"]
    },
    "unitKey": {
      "type": "string"
    },
    "structureLevel": {
      "type": "integer",
      "minimum": 1
    },
    "startsAtUnitBoundary": {
      "type": "boolean",
      "default": true
    },
    "endsAtUnitBoundary": {
      "type": "boolean",
      "default": true
    },
    "headingPath": {
      "type": "array",
      "description": "祖先标题链，自最外层到最内层；继承自 RawChunk，原样透传保序（§6.1）。",
      "items": { "type": "string" }
    },
    "relations": {
      "$ref": "#/$defs/relations"
    }
  },
  "$defs": {
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousChunkId", "nextChunkId", "parentChunkId"],
      "properties": {
        "previousChunkId": {
          "type": ["string", "null"]
        },
        "nextChunkId": {
          "type": ["string", "null"]
        },
        "parentChunkId": {
          "type": ["string", "null"],
          "description": "deprecated，1.0.0 移除。最近的前序 heading 块；heading 块指向层级更浅的前序 heading 块。语义等同 structuralParentChunkId，二者同现时值必须一致（CCJ-014）。"
        },
        "structuralParentChunkId": {
          "type": ["string", "null"],
          "description": "结构父：文档大纲层级的最近前序 heading 父块。"
        },
        "contextParentChunkId": {
          "type": ["string", "null"],
          "description": "上下文父：双库模式下归属的 contextParent。parentChild.enabled=false 时不得出现（CCJ-013）。"
        }
      }
    }
  }
}
