{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chunkjudge.ambos.cn/schema/chunk-strategy-options.json",
  "title": "ChunkStrategyOptions",
  "description": "切片策略选项。策略名由 strategyType 与 targetSize 拼成 {type}@{targetSize}。",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategyType", "targetSize"],
  "properties": {
    "strategyType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "targetSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1500
    },
    "maxChunkSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1500,
      "default": 1500,
      "description": "单块硬上限，不得大于契约常量 MAX_CHUNK_CHARS=1500。"
    },
    "minChunkSize": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "preserveStructure": {
      "type": "boolean",
      "default": true
    },
    "overlap": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "相邻块重叠字符数，须小于 targetSize。"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "chunkMode": {
      "type": "string",
      "enum": ["regex", "smart", "page"],
      "description": "切分方式，由模板决策回填；page 模式豁免 CCJ-015。"
    },
    "parentChild": {
      "type": "object",
      "additionalProperties": false,
      "description": "双库（Parent/Child）配置。enabled 为强布尔：关闭即本批次不得产出父块相关字段。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "parentMaxChars": {
          "type": "integer",
          "minimum": 1,
          "default": 6000,
          "description": "父块长度告警阈值配置项，非上限；6000 为临时调试默认值，正式基准由不少于 50 份目标业务文档父块长度 P95 标定。契约不设全局硬封顶。"
        }
      }
    }
  }
}
